<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="left_ur16e">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import left_ur16e urdf file -->
    <xacro:include filename="$(find dual_arm_workcell_description)/urdf/dual_arm_workcell.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="left_ur16e.ros2_control.xacro" />


    <xacro:left_ur16e_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
